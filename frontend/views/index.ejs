<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Registration | Node.js & Flask Docker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <div class="header">
      <span class="badge">Docker & Docker Compose Assignment</span>
      <h1 class="title">Full-Stack Docker App</h1>
      <p class="subtitle">Node.js/Express Frontend &#8594; Flask API Backend</p>
    </div>


    <!-- Error Display (without redirection) -->
    <% if (error) { %>
    <div class="alert-error" role="alert">
      <span>&#9888;</span>
      <div><%= error %></div>
    </div>
    <% } %>

    <form action="/submit" method="POST">
      <div class="form-group">
        <label for="name">Full Name *</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          placeholder="e.g. Shubhajit Paul" 
          value="<%= (formData && formData.name) ? formData.name : '' %>" 
          required
        >
      </div>


      <div class="form-group">
        <label for="email">Email Address *</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          placeholder="e.g. shubhajit@example.com" 
          value="<%= (formData && formData.email) ? formData.email : '' %>" 
          required
        >
      </div>


      <div class="form-group">
        <label for="course">Select Course *</label>
        <select id="course" name="course" required>
          <option value="">-- Choose Course --</option>
          <option value="DevOps Masterclass" <%= (formData && formData.course === 'DevOps Masterclass') ? 'selected' : '' %>>DevOps Masterclass</option>
          <option value="Docker & Containerization" <%= (formData && formData.course === 'Docker & Containerization') ? 'selected' : '' %>>Docker & Containerization</option>
          <option value="Kubernetes & CI/CD" <%= (formData && formData.course === 'Kubernetes & CI/CD') ? 'selected' : '' %>>Kubernetes & CI/CD</option>
          <option value="Cloud & Terraform" <%= (formData && formData.course === 'Cloud & Terraform') ? 'selected' : '' %>>Cloud & Terraform</option>
        </select>
      </div>


      <div class="form-group">
        <label for="message">Message / Remarks (Optional</label>
        <textarea 
          id="message" 
          name="message" 
          rows="3" 
          placeholder="Any special remarks or questions..."
        ><%= (formData && formData.message) ? formData.message : '' %></textarea>
      </div>


      <button type="submit" class="btn-submit">Save to Flask Backend</button>
    </form>


    <div class="nav-links">
      <a href="/health" target="_blank">&#128110; Frontend Health</a>
      <span style="color: #6b7280;">Backend: <%= backendUrl %></span>
    </div>
  </div>
</body>
</html>
